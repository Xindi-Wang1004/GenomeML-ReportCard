{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Xindi-Wang1004/Spillover/transfer_GB/audit_toolkit/schemas/reportcard_report.schema.json",
  "title": "GenomeML Report Card audit report",
  "description": "Machine-readable output of genome-ml-reportcard (v0.1.x). Validates required top-level fields and nested geometry/probe diagnostics.",
  "type": "object",
  "required": ["tool", "version", "n_rows", "n_groups", "columns", "geometry", "probe"],
  "additionalProperties": true,
  "properties": {
    "tool": {"type": "string", "const": "genome-ml-reportcard"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"},
    "n_rows": {"type": "integer", "minimum": 1},
    "n_groups": {"type": "integer", "minimum": 1},
    "columns": {
      "type": "object",
      "required": ["accession", "label_assignment_unit", "blocking_unit", "label"],
      "properties": {
        "accession": {"type": "string", "minLength": 1},
        "label_assignment_unit": {"type": "string", "minLength": 1},
        "blocking_unit": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "geometry": {
      "type": "object",
      "required": [
        "random_cv_shared_block_fraction",
        "within_block_homogeneity",
        "metric_type"
      ],
      "properties": {
        "random_cv_shared_block_fraction": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "within_block_homogeneity": {"type": ["number", "null"]},
        "metric_type": {"type": "string"},
        "n_rows": {"type": "integer"},
        "n_label_groups": {"type": "integer"},
        "label_unit_stats": {"type": "object"},
        "block_stats": {"type": "object"}
      },
      "additionalProperties": true
    },
    "probe": {
      "type": "object",
      "required": ["primary_metric", "random", "blocked", "delta", "warnings"],
      "properties": {
        "seed": {"type": "integer"},
        "schema": {"type": "array", "items": {"type": "string"}},
        "primary_metric": {"type": "string", "enum": ["rho", "auc"]},
        "random": {"type": "object"},
        "blocked": {"type": "object"},
        "delta": {"type": ["number", "null"]},
        "delta_rho": {"type": ["number", "null"]},
        "n": {"type": "integer"},
        "n_groups": {"type": "integer"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "overlap": {"type": "object"},
    "manifest_sha256": {"type": "string"}
  }
}
